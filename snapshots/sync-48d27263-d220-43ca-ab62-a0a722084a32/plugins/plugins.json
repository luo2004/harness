    {
      "file": "profiles/web/cordis.patch.yml",
      "lineId": "llm-pi-ai",
      "raw": {
        "id": "llm-pi-ai",
        "name": "@deepseek-ai/dsh-llm-pi-ai",
        "config": {
          "providers": {
            "r4coder": {
              "apiKeyEnv": "R4CODER_API_KEY",
              "api": "openai-responses",
              "baseURL": "https://api.r4.codes/v1",
              "models": [
                {
                  "id": "deepseek-v4.1-flash",
                  "name": "DeepSeek V4.1 Flash (1017)",
                  "contextWindow": 1048576,
                  "input": [
                    "text",
                    "image"
                  ],
                  "reasoningEfforts": {
                    "off": "none",
                    "low": "low",
                    "high": "high",
                    "max": "max"
                  },
                  "reasoningEffortsAutofilled": 1
                },
                {
                  "id": "glm-5.3",
                  "name": "GLM 5.3",
                  "contextWindow": 1048576,
                  "reasoningEfforts": {
                    "low": "low",
                    "high": "high",
                    "max": "max"
                  },
                  "reasoningEffortsAutofilled": 1,
                  "input": [
                    "text"
                  ]
                },
                {
                  "id": "glm-5.3-flash",
                  "name": "GLM 5.3 Flash",
                  "contextWindow": 1048576,
                  "input": [
                    "text",
                    "image"
                  ],
                  "reasoningEfforts": {
                    "low": "low",
                    "high": "high",
                    "max": "max"
                  },
                  "reasoningEffortsAutofilled": 1
                }
              ]
            }
          }
        }
      }
    },
