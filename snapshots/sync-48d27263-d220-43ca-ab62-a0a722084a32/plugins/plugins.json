    {
      "file": "profiles/web/cordis.patch.yml",
      "lineId": "mnemon",
      "raw": {
        "id": "mnemon",
        "name": "dsh-mnemon",
        "config": {
          "remoteAccess": "read-only",
          "timeoutMs": 10000,
          "defaultRecallLimit": 10,
          "embedding": {
            "enabled": false,
            "endpoint": "http://localhost:11434",
            "model": "nomic-embed-text",
            "apiKey": "",
            "protocol": "auto"
          },
          "memoryView": {
            "strategyTypeId": "default-three-tier",
            "entries": {
              "include:mnemon-strategy-auto-capture": {
                "enabled": true,
                "config": {
                  "sourceKeys": [
                    "source:include:mnemon-source-memory-spaces"
                  ]
                }
              },
              "include:mnemon-strategy-light-context": {
                "enabled": true,
                "config": {}
              },
              "include:mnemon-strategy-scoped": {
                "enabled": true,
                "config": {}
              },
              "include:mnemon-strategy-general": {
                "enabled": false,
                "config": {}
              }
            }
          },
          "legacySettingsImported": true,
          "recallQuality": {
            "policy": "strict-v1",
            "lowScoreThreshold": 0.25,
            "highScoreThreshold": 0.6,
            "candidateMultiplier": 3,
            "maxMediumResults": 4,
            "maxUnknownResults": 2
          },
          "routingGuidance": true,
          "tabEnabled": true,
          "writeEnabled": true,
          "lifecycleEnabled": true,
          "recallMode": "guided",
          "writebackMode": "guided",
          "idleReviewMs": 30000,
          "persistenceStrategy": {
            "mode": "automatic",
            "providerId": "mnemon-native",
            "prompt": "",
            "rules": {
              "allowedProviderIds": [
                "mnemon-native",
                "holographic",
                "byterover",
                "hindsight"
              ],
              "dataBoundary": "allow-remote",
              "requiredCapabilities": [
                "graph",
                "forget",
                "exact-write"
              ],
              "preference": "local-first"
            },
            "providerConnections": {
              "holographic": {
                "defaultTrust": 0.5,
                "minTrust": 0.3
              },
              "byterover": {},
              "hindsight": {
                "bankId": "dsh",
                "budget": "mid"
              }
            }
          },
          "skills": {
            "evolution": true,
            "autoBacktest": true,
            "hints": true,
            "sidebar": false,
            "reviewThreshold": 5,
            "idleSeconds": 20,
            "cooldownSeconds": 150,
            "minConfidence": 0.6,
            "expiryDays": 7,
            "maxPendingPerSession": 5,
            "casesPerRun": 8
          }
        }
      }
    },
    {
